# Lynx core: the 25MHz and 32MHz domains only meet in synchronizers and
# the dual-clock frame buffer (see rtl/lynx_phoenix.v).
NET "clk_25m0_s" TNM_NET = "GRP_25";
NET "clk_32_s"   TNM_NET = "GRP_LYNX";
TIMESPEC "TS_25_to_lynx_ignore" = FROM "GRP_25" TO "GRP_LYNX" TIG;
TIMESPEC "TS_lynx_to_25_ignore" = FROM "GRP_LYNX" TO "GRP_25" TIG;

# SRAM: fast edges.  A read has one 31.25ns clock.
NET "sram_addr_o<*>" SLEW = FAST;
NET "sram_data_io<*>" SLEW = FAST;
NET "sram_oe_n_o"     SLEW = FAST;
NET "sram_we_n_o"     SLEW = FAST;
