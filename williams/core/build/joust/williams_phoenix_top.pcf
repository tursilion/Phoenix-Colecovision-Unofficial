PIN tmds_out/g1[1].to_serial_pins<1> = BEL "tmds_out/g1[1].to_serial" PINNAME
        CK0;
PIN tmds_out/g1[2].to_serial_pins<1> = BEL "tmds_out/g1[2].to_serial" PINNAME
        CK0;
PIN tmds_out/g1[3].to_serial_pins<1> = BEL "tmds_out/g1[3].to_serial" PINNAME
        CK0;
TIMEGRP clock_system_clkout2 = BEL "clock_system/clkout3_buf" BEL
        "tmds_out/shift_r_0" BEL "tmds_out/shift_r_1" BEL "tmds_out/shift_r_2"
        BEL "tmds_out/shift_r_3" BEL "tmds_out/shift_r_4" BEL
        "tmds_out/shift_r_5" BEL "tmds_out/shift_r_6" BEL "tmds_out/shift_r_7"
