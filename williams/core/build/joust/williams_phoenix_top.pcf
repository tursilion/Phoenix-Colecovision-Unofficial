        "tmds_out/g1[0].to_serial_pins<2>" PIN
        "tmds_out/g1[1].to_serial_pins<2>" PIN
        "tmds_out/g1[2].to_serial_pins<2>" PIN
        "tmds_out/g1[3].to_serial_pins<2>";
PIN SP6_BUFIO2_INSERT_PLL1_ML_BUFIO2_0_pins<0> = BEL
        "SP6_BUFIO2_INSERT_PLL1_ML_BUFIO2_0" PINNAME DIVCLK;
PIN clock_system/pll_base_inst/PLL_ADV_pins<2> = BEL
        "clock_system/pll_base_inst/PLL_ADV" PINNAME CLKIN1;
TIMEGRP clock_50m0_i_net = PIN "SP6_BUFIO2_INSERT_PLL1_ML_BUFIO2_0_pins<0>"
        PIN "clock_system/pll_base_inst/PLL_ADV_pins<2>";
TS_clock_50m0_i_net = PERIOD TIMEGRP "clock_50m0_i_net" 20 ns HIGH 50%;
PATH TS_25_to_w_ignore_path = FROM TIMEGRP "GRP_25" TO TIMEGRP "GRP_W";
PATH "TS_25_to_w_ignore_path" TIG;
PATH TS_w_to_25_ignore_path = FROM TIMEGRP "GRP_W" TO TIMEGRP "GRP_25";
PATH "TS_w_to_25_ignore_path" TIG;
TS_clock_system_clkout3 = PERIOD TIMEGRP "clock_system_clkout3"
        TS_clock_50m0_i_net / 2.5 PHASE 4 ns HIGH 50%;
TS_clock_system_clkout0 = PERIOD TIMEGRP "clock_system_clkout0"
        TS_clock_50m0_i_net / 0.5 HIGH 50%;
TS_clock_system_clkout2 = PERIOD TIMEGRP "clock_system_clkout2"
        TS_clock_50m0_i_net / 2.5 HIGH 50%;
TS_clk_fx_s = PERIOD TIMEGRP "clk_fx_s" TS_clock_system_clkout0 / 1.92 HIGH
        50%;
TS_clk_fxdv_s = PERIOD TIMEGRP "clk_fxdv_s" TS_clock_system_clkout0 / 0.48
        HIGH 50%;
SCHEMATIC END;

