        "tmds_out/shift_clk_0" BEL "tmds_out/shift_clk_1" BEL
        "tmds_out/shift_clk_3" BEL "tmds_out/mod5_0" BEL "tmds_out/mod5_1" BEL
        "tmds_out/mod5_2" PIN "tmds_out/g1[0].to_serial_pins<1>" PIN
        "tmds_out/g1[1].to_serial_pins<1>" PIN
        "tmds_out/g1[2].to_serial_pins<1>" PIN
        "tmds_out/g1[3].to_serial_pins<1>";
